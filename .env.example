# MemoryHub Local Environment Configuration Template
# Copy this file to .env and configure local development values.

# Database Configuration
# Option A (Hosted/Managed PostgreSQL on Render/Supabase/Neon/RDS):
# DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/memoryhub
# Option B (Local/Containerized PostgreSQL with discrete parameters):
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=memoryhub
POSTGRES_USER=memoryhub_user
POSTGRES_PASSWORD=replace_with_strong_password

# Environment Mode ("production" enforces managed PostgreSQL; "development" allows local SQLite fallback)
ENVIRONMENT=development
# REQUIRE_POSTGRES=false

# CORS Configuration (comma-separated list of allowed production frontend URLs)
# CORS_ORIGINS=https://memoryhub.vercel.app,https://your-custom-domain.com
# ALLOW_VERCEL_PREVIEWS=true

# ChromaDB Configuration
CHROMA_URL=http://127.0.0.1:8001

# Authentication Configuration
JWT_SECRET=replace_with_strong_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Configuration (heuristic by default; safe offline mode)
AI_PROVIDER=heuristic
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15.0
GEMINI_MAX_OUTPUT_TOKENS=1024
